// markdownlint settings for this repository (the VS Code extension reads
// this file). While it exists the extension's own defaults are not applied,
// so the extension default "MD013": false is written out here.
{
  // Line length: README paragraphs are written as prose, one line each.
  "MD013": false,
  // GitHub Markdown has no way to centre content; the profile README and
  // ARCHIVE.md use <div align="center"> for that and nothing else. Any
  // other inline HTML is still reported.
  "MD033": { "allowed_elements": ["div"] },
  // The first line is the centring <div>; content before the first heading
  // is allowed, the first heading must still be an h1.
  "MD041": { "allow_preamble": true }
}
